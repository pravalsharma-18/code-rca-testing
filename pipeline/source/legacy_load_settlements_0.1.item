<?xml version="1.0" encoding="UTF-8"?>
<!-- Talend job: load_settlements v0.1 (LEGACY / Teradata - the CORRECT original pipeline).
     SOURCE-side artifact for Code RCA in Scenario 4.
     Flow: settlements_raw (main, keeps ACTIVE + PARTIAL) + adjustments (lookup,
           PRE-AGGREGATED per settlement) -> tMap LEFT OUTER JOIN (unique match)
           -> settlements. -->
<talendfile:ProcessType xmlns:xmi="http://www.omg.org/XMI"
    xmlns:talendfile="platform:/resource/org.talend.model/model/TalendFile.xsd"
    defaultContext="Default" jobType="Standard">
  <context confirmationNeeded="false" name="Default">
    <contextParameter comment="Legacy EDW schema" name="edw_schema" prompt="Schema?" type="id_String" value="edw_fin"/>
  </context>
  <parameters>
    <elementParameter field="TEXT" name="JOB_NAME" value="load_settlements"/>
    <elementParameter field="TEXT" name="JOB_VERSION" value="0.1"/>
    <elementParameter field="TEXT" name="PURPOSE" value="Load settlement records net of adjustments into settlements"/>
    <elementParameter field="TEXT" name="DESCRIPTION" value="Keeps every non-cancelled settlement (ACTIVE and PARTIAL). Adjustments are rolled up per settlement BEFORE the lookup join so a settlement with multiple adjustment records can never multiply rows. Settlements without adjustments survive via the LEFT OUTER join."/>
  </parameters>

  <node componentName="tTeradataInput" componentVersion="0.102" posX="64" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tTeradataInput_1"/>
    <elementParameter field="TEXT" name="LABEL" value="read_settlements_raw"/>
    <elementParameter field="MEMO_SQL" name="QUERY"
      value="&quot;SELECT settlement_id, order_id, invoice_ref, channel, settled_on, is_reconciled, tax_amount, remarks, gross_amount, fee_amount, status FROM &quot; + context.edw_schema + &quot;.settlements_raw WHERE status &lt;&gt; 'CANCELLED'&quot;"/>
    <metadata connector="FLOW" name="row_raw">
      <column key="true"  length="16" name="settlement_id" nullable="false" type="id_String"/>
      <column key="false" length="16" name="order_id"      nullable="false" type="id_String"/>
      <column key="false" length="32" name="invoice_ref"   nullable="true"  type="id_String"/>
      <column key="false" length="8"  name="channel"       nullable="true"  type="id_String"/>
      <column key="false" name="settled_on" nullable="true" pattern="&quot;yyyy-MM-dd&quot;" type="id_Date"/>
      <column key="false" length="1"  name="is_reconciled" nullable="true"  type="id_Integer"/>
      <column key="false" length="12" name="tax_amount"    nullable="true"  precision="2" type="id_BigDecimal"/>
      <column key="false" length="256" name="remarks"      nullable="true"  type="id_String"/>
      <column key="false" length="12" name="gross_amount"  nullable="true"  precision="2" type="id_BigDecimal"/>
      <column key="false" length="12" name="fee_amount"    nullable="true"  precision="2" type="id_BigDecimal"/>
      <column key="false" length="12" name="status"        nullable="true"  type="id_String"/>
    </metadata>
  </node>

  <node componentName="tTeradataInput" componentVersion="0.102" posX="64" posY="256">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tTeradataInput_2"/>
    <elementParameter field="TEXT" name="LABEL" value="read_adjustments"/>
    <elementParameter field="MEMO_SQL" name="QUERY"
      value="&quot;SELECT settlement_id, adj_amount FROM &quot; + context.edw_schema + &quot;.adjustments&quot;"/>
    <metadata connector="FLOW" name="row_adj_raw">
      <column key="false" length="16" name="settlement_id" nullable="false" type="id_String"/>
      <column key="false" length="12" name="adj_amount"    nullable="true"  precision="2" type="id_BigDecimal"/>
    </metadata>
  </node>

  <!-- CRITICAL STEP: roll adjustments up to ONE row per settlement before the lookup. -->
  <node componentName="tAggregateRow" componentVersion="2.1" posX="224" posY="256">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tAggregateRow_1"/>
    <elementParameter field="TEXT" name="LABEL" value="adjustments_per_settlement"/>
    <elementParameter field="TABLE" name="GROUPBYS">
      <elementValue elementRef="OUTPUT_COLUMN" value="settlement_id"/>
      <elementValue elementRef="INPUT_COLUMN" value="settlement_id"/>
    </elementParameter>
    <elementParameter field="TABLE" name="OPERATIONS">
      <elementValue elementRef="OUTPUT_COLUMN" value="adj_total"/>
      <elementValue elementRef="FUNCTION" value="sum"/>
      <elementValue elementRef="INPUT_COLUMN" value="adj_amount"/>
    </elementParameter>
    <metadata connector="FLOW" name="row_adj">
      <column key="true"  length="16" name="settlement_id" nullable="false" type="id_String"/>
      <column key="false" length="14" name="adj_total"     nullable="true"  precision="2" type="id_BigDecimal"/>
    </metadata>
  </node>

  <node componentName="tMap" componentVersion="2.4" posX="400" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMap_1"/>
    <elementParameter field="TEXT" name="LABEL" value="join_adjustments"/>
    <nodeData xsi:type="mapper:MapperData" xmlns:mapper="http://www.talend.org/mapper"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <inputTables name="row_raw" lookupMode="LOAD_ONCE" matchingMode="UNIQUE_MATCH" innerJoin="false"/>
      <!-- Lookup joined LEFT OUTER (innerJoin="false"): settlements without adjustments MUST survive. -->
      <inputTables name="row_adj" lookupMode="LOAD_ONCE" matchingMode="UNIQUE_MATCH" innerJoin="false">
        <mapperTableEntries expression="row_raw.settlement_id" name="settlement_id" type="id_String"/>
      </inputTables>
      <outputTables name="out_settlements">
        <mapperTableEntries expression="row_raw.settlement_id" name="settlement_id" type="id_String"/>
        <mapperTableEntries expression="row_raw.order_id"      name="order_id"      type="id_String"/>
        <mapperTableEntries expression="row_raw.invoice_ref"   name="invoice_ref"   type="id_String"/>
        <mapperTableEntries expression="row_raw.channel"       name="channel"       type="id_String"/>
        <mapperTableEntries expression="TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, row_raw.settled_on)"
                            name="settled_on" type="id_String"/>
        <mapperTableEntries expression="String.valueOf(row_raw.is_reconciled)"
                            name="is_reconciled" type="id_String"/>
        <mapperTableEntries expression="new java.text.DecimalFormat(&quot;0.00&quot;).format(row_raw.tax_amount)"
                            name="tax_amount" type="id_String"/>
        <mapperTableEntries expression="(row_raw.remarks == null || row_raw.remarks.isEmpty()) ? null : row_raw.remarks"
                            name="remarks" type="id_String"/>
        <mapperTableEntries expression="row_raw.gross_amount"  name="gross_amount" type="id_BigDecimal"/>
        <mapperTableEntries expression="row_raw.fee_amount"    name="fee_amount"   type="id_BigDecimal"/>
        <mapperTableEntries expression="row_raw.gross_amount.subtract(row_raw.fee_amount).subtract(row_adj.adj_total == null ? java.math.BigDecimal.ZERO : row_adj.adj_total)"
                            name="net_amount" type="id_BigDecimal"/>
      </outputTables>
    </nodeData>
  </node>

  <node componentName="tTeradataOutput" componentVersion="0.102" posX="576" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tTeradataOutput_1"/>
    <elementParameter field="TEXT" name="LABEL" value="write_settlements"/>
    <elementParameter field="TEXT" name="TABLE" value="&quot;settlements&quot;"/>
    <elementParameter field="CLOSED_LIST" name="TABLE_ACTION" value="TRUNCATE"/>
    <elementParameter field="CLOSED_LIST" name="DATA_ACTION" value="INSERT"/>
  </node>

  <connection connectorName="FLOW" label="row_raw"        lineStyle="0" source="tTeradataInput_1" target="tMap_1"/>
  <connection connectorName="FLOW" label="row_adj_raw"    lineStyle="0" source="tTeradataInput_2" target="tAggregateRow_1"/>
  <connection connectorName="FLOW" label="row_adj"        lineStyle="2" source="tAggregateRow_1"  target="tMap_1"/>
  <connection connectorName="FLOW" label="out_settlements" lineStyle="0" source="tMap_1"          target="tTeradataOutput_1"/>
</talendfile:ProcessType>
